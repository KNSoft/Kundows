<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSBin2cHostPlatform>$(Platform)</ReactOSBin2cHostPlatform>
    <ReactOSBin2cHostPlatform Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">x64</ReactOSBin2cHostPlatform>
    <ReactOSBin2cTool>$(KundowsRoot)OutDir\HostTools\$(ReactOSBin2cHostPlatform)\$(Configuration)\bin2c.exe</ReactOSBin2cTool>
  </PropertyGroup>
  <Target Name="GenerateReactOSBin2cProjectFiles"
          BeforeTargets="ClCompile;ResourceCompile;Lib;Link;Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(ReactOSBin2c)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSBin2cTool);%(ReactOSBin2c.Identity)"
          Outputs="%(ReactOSBin2c.Outputs)">
    <MakeDir Directories="%(ReactOSBin2c.OutputDirectory)" />
    <Exec Command="&quot;$(ReactOSBin2cTool)&quot; %(ReactOSBin2c.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSBin2c.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
