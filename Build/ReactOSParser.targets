<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSParserSnapshotRoot Condition="'$(ReactOSParserSnapshotRoot)' == ''">$(KundowsRoot)Build\ReactOSParserSources\</ReactOSParserSnapshotRoot>
    <ReactOSParserGeneratedDirectory Condition="'$(ReactOSParserGeneratedDirectory)' == ''">$(KundowsRoot)OutDir\Build\Generated\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</ReactOSParserGeneratedDirectory>
  </PropertyGroup>

  <Target Name="GenerateReactOSParserSources"
          Condition="'@(ReactOSParserSource)' != ''"
          BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectFullPath);@(ReactOSParserSource->'%(Snapshot)');@(ReactOSParserInput)"
          Outputs="@(ReactOSParserSource->'%(Destination)')">
    <MakeDir Directories="$(ReactOSParserGeneratedDirectory)" />
    <Copy
      SourceFiles="@(ReactOSParserSource->'%(Snapshot)')"
      DestinationFiles="@(ReactOSParserSource->'%(Destination)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GenerateReactOSInferredParserSources"
          BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'asmshader.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)D3dcompiler\asmshader.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'asmshader.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)D3dcompiler\asmshader.tab.h</Snapshot>
        <Destination>%(ClCompile.RootDir)%(ClCompile.Directory)asmshader.tab.h</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'asmshader.yy'">
        <Snapshot>$(ReactOSParserSnapshotRoot)D3dcompiler\asmshader.yy.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'macro.lex.yy'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Winhlp32-macro.lex.yy.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'hlsl.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\hlsl.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'hlsl.yy'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\hlsl.yy.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'preproc.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\preproc.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'preproc.yy'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\preproc.yy.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'xslpattern.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msxml3\xslpattern.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'xslpattern.yy'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msxml3\xslpattern.yy.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'wql.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Wbemprox\wql.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'cc_parser.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Jscript\cc_parser.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'parser.tab' and $([System.String]::Copy('%(ClCompile.FullPath)').Contains('\dll\win32\jscript\'))">
        <Snapshot>$(ReactOSParserSnapshotRoot)Jscript\parser.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'cond.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msi\cond.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'sql.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msi\sql.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserSource Include="@(ClCompile)"
                                   Condition="'%(ClCompile.Filename)' == 'parser.tab' and $([System.String]::Copy('%(ClCompile.FullPath)').Contains('\dll\win32\vbscript\'))">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vbscript\parser.tab.c</Snapshot>
        <Destination>%(ClCompile.FullPath)</Destination>
      </ReactOSInferredParserSource>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'hlsl.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\hlsl.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'preproc.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vkd3d\preproc.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'xslpattern.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msxml3\xslpattern.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'wql.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Wbemprox\wql.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'cc_parser.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Jscript\cc_parser.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'parser.tab' and $([System.String]::Copy('%(ClInclude.FullPath)').Contains('\dll\win32\jscript\'))">
        <Snapshot>$(ReactOSParserSnapshotRoot)Jscript\parser.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'cond.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msi\cond.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'sql.tab'">
        <Snapshot>$(ReactOSParserSnapshotRoot)Msi\sql.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
      <ReactOSInferredParserInclude Include="@(ClInclude)"
                                    Condition="'%(ClInclude.Filename)' == 'parser.tab' and $([System.String]::Copy('%(ClInclude.FullPath)').Contains('\dll\win32\vbscript\'))">
        <Snapshot>$(ReactOSParserSnapshotRoot)Vbscript\parser.tab.h</Snapshot>
        <Destination>%(ClInclude.FullPath)</Destination>
      </ReactOSInferredParserInclude>
    </ItemGroup>
    <MakeDir Directories="@(ReactOSInferredParserSource->'%(RootDir)%(Directory)')" />
    <MakeDir Directories="@(ReactOSInferredParserInclude->'%(RootDir)%(Directory)')" />
    <Copy
      SourceFiles="@(ReactOSInferredParserSource->'%(Snapshot)')"
      DestinationFiles="@(ReactOSInferredParserSource->'%(Destination)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(ReactOSInferredParserInclude->'%(Snapshot)')"
      DestinationFiles="@(ReactOSInferredParserInclude->'%(Destination)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
