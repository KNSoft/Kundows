<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSBootSectorHostPlatform>$(Platform)</ReactOSBootSectorHostPlatform>
    <ReactOSBootSectorHostPlatform Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">x64</ReactOSBootSectorHostPlatform>
    <ReactOSObj2BinTool>$(KundowsRoot)OutDir\HostTools\$(ReactOSBootSectorHostPlatform)\$(Configuration)\obj2bin.exe</ReactOSObj2BinTool>
  </PropertyGroup>
  <Target Name="CopyReactOSAsm16"
          Condition="'@(ReactOSAsm16Copy)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);%(ReactOSAsm16Copy.Identity)"
          Outputs="%(ReactOSAsm16Copy.Outputs)">
    <Copy SourceFiles="%(ReactOSAsm16Copy.Identity)" DestinationFiles="%(ReactOSAsm16Copy.Outputs)" />
  </Target>
  <Target Name="PreprocessReactOSBootSector"
          DependsOnTargets="ResolveProjectReferences;CopyReactOSAsm16"
          Condition="'@(ReactOSBootPreprocess)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\cl.exe;%(ReactOSBootPreprocess.Identity)"
          Outputs="%(ReactOSBootPreprocess.Outputs)">
    <MakeDir Directories="%(ReactOSBootPreprocess.OutputDirectory)" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\cl.exe&quot; %(ReactOSBootPreprocess.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSBootPreprocess.Outputs);@(ReactOSAsm16Copy->'%(Outputs)')" />
    </ItemGroup>
  </Target>
  <Target Name="AssembleReactOSBootSector"
          DependsOnTargets="PreprocessReactOSBootSector"
          Condition="'@(ReactOSBootAssemble)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\x86\ml.exe;%(ReactOSBootAssemble.Identity)"
          Outputs="%(ReactOSBootAssemble.Outputs)">
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\x86\ml.exe&quot; %(ReactOSBootAssemble.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSBootAssemble.Outputs)" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateReactOSBootSectorProjectFiles"
          BeforeTargets="ClCompile;ResourceCompile;Lib;Link;Build"
          DependsOnTargets="AssembleReactOSBootSector"
          Condition="'@(ReactOSBootConvert)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSObj2BinTool);%(ReactOSBootConvert.Identity)"
          Outputs="%(ReactOSBootConvert.Outputs)">
    <Exec Command="&quot;$(ReactOSObj2BinTool)&quot; %(ReactOSBootConvert.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSBootConvert.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
