<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSSpec2DefTool Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">$(KundowsRoot)OutDir\HostTools\x64\$(Configuration)\spec2def.exe</ReactOSSpec2DefTool>
    <ReactOSSpec2DefTool Condition="'$(Platform)' != 'ARM64' or ('$(PROCESSOR_ARCHITECTURE)' != 'AMD64' and '$(PROCESSOR_ARCHITEW6432)' != 'AMD64')">$(KundowsRoot)OutDir\HostTools\$(Platform)\$(Configuration)\spec2def.exe</ReactOSSpec2DefTool>
  </PropertyGroup>

  <Target Name="GenerateReactOSSpec2Def"
          BeforeTargets="PrepareForBuild"
          Condition="'@(ReactOSSpec2Def)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSSpec2DefTool);%(ReactOSSpec2Def.Identity)"
          Outputs="%(ReactOSSpec2Def.Outputs)">
    <MakeDir Directories="%(ReactOSSpec2Def.OutputDirectory)" />
    <Exec Command="&quot;$(ReactOSSpec2DefTool)&quot; %(ReactOSSpec2Def.Arguments) &quot;%(ReactOSSpec2Def.Identity)&quot;" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSSpec2Def.Outputs)" />
    </ItemGroup>
  </Target>

  <Target Name="CompileReactOSSpec2DefStubs"
          DependsOnTargets="GenerateReactOSSpec2Def"
          BeforeTargets="PrepareForBuild"
          Condition="'@(ReactOSSpec2DefStub)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\%(ReactOSSpec2DefStub.Tool);%(ReactOSSpec2DefStub.Identity)"
          Outputs="%(ReactOSSpec2DefStub.Outputs)">
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\%(ReactOSSpec2DefStub.Tool)&quot; %(ReactOSSpec2DefStub.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSSpec2DefStub.Outputs)" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateReactOSImportLibrary"
          DependsOnTargets="CompileReactOSSpec2DefStubs"
          BeforeTargets="PrepareForBuild"
          Condition="'@(ReactOSImportLibrary)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\link.exe;%(ReactOSImportLibrary.Identity);%(ReactOSImportLibrary.AdditionalInputs)"
          Outputs="%(ReactOSImportLibrary.Outputs)">
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Host$(PreferredToolArchitecture)\$(PlatformShortName)\link.exe&quot; %(ReactOSImportLibrary.Arguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSImportLibrary.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
