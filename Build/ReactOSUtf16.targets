<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSUtf16HostPlatform>$(Platform)</ReactOSUtf16HostPlatform>
    <ReactOSUtf16HostPlatform Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">x64</ReactOSUtf16HostPlatform>
    <ReactOSUtf16Tool>$(KundowsRoot)OutDir\HostTools\$(ReactOSUtf16HostPlatform)\$(Configuration)\utf16le.exe</ReactOSUtf16Tool>
  </PropertyGroup>
  <Target Name="GenerateReactOSUtf16ProjectFiles"
          BeforeTargets="ClCompile;ResourceCompile;Lib;Link;Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(ReactOSUtf16)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSUtf16Tool);%(ReactOSUtf16.Identity)"
          Outputs="%(ReactOSUtf16.Outputs)">
    <MakeDir Directories="%(ReactOSUtf16.OutputDirectory)" />
    <!-- utf16le reports ambiguous UTF-32 BOMs as "UTF Error" but returns 0.
         Preserve the upstream exit status instead of MSBuild's text heuristic. -->
    <Exec Command="&quot;$(ReactOSUtf16Tool)&quot; %(ReactOSUtf16.Arguments)" IgnoreStandardErrorWarningFormat="true" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSUtf16.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
