<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSMessageEnabled Condition="'$(ReactOSMessageEnabled)' == ''">true</ReactOSMessageEnabled>
    <ReactOSMessageScript Condition="'$(ReactOSMessageScript)' == ''">$(KundowsRoot)Build\GenerateReactOSMessageHeaders.ps1</ReactOSMessageScript>
    <ReactOSMessageGeneratedRoot Condition="'$(ReactOSMessageGeneratedRoot)' == ''">$(KundowsRoot)OutDir\Build\Generated\$(Platform)\$(Configuration)</ReactOSMessageGeneratedRoot>
    <ReactOSMessageProjectStamp>$(IntDir)ReactOSMessage\Project.stamp</ReactOSMessageProjectStamp>
  </PropertyGroup>

  <Target Name="GenerateReactOSMessageProjectFiles"
          Condition="'$(ReactOSMessageEnabled)' == 'true' and '$(ReactOSMessageProjectGeneration)' != 'false' and '@(None->WithMetadataValue('Filename','CMakeLists'))' != ''"
          BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectFullPath);$(ReactOSMessageScript);@(None)"
          Outputs="$(ReactOSMessageProjectStamp)">
    <ItemGroup>
      <ReactOSMessageProjectCMake Include="@(None->WithMetadataValue('Filename','CMakeLists'))">
        <CMakeListFile>%(FullPath)</CMakeListFile>
        <SourceDirectory>%(RootDir)%(Directory).</SourceDirectory>
      </ReactOSMessageProjectCMake>
    </ItemGroup>
    <MakeDir Directories="$(IntDir)ReactOSMessage\" />
    <Exec Condition="'%(ReactOSMessageProjectCMake.CMakeListFile)' != ''"
          Command="pwsh.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(ReactOSMessageScript)&quot; -WindowsSdkDir &quot;$(WindowsSdkDir).&quot; -SourceRoot &quot;$(KundowsRoot)Upstream\ReactOS\Source&quot; -GeneratedRoot &quot;$(ReactOSMessageGeneratedRoot)&quot; -CMakeListFile &quot;%(ReactOSMessageProjectCMake.CMakeListFile)&quot; -SourceDirectory &quot;%(ReactOSMessageProjectCMake.SourceDirectory)&quot; -Mode Project" />
    <Touch Files="$(ReactOSMessageProjectStamp)" AlwaysCreate="true" />
  </Target>
</Project>
