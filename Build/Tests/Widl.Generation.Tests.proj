<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="Build">
    <ReadLinesFromFile File="$(ProjectList)">
      <Output TaskParameter="Lines" ItemName="NativeProject" />
    </ReadLinesFromFile>
    <MSBuild Projects="@(NativeProject)"
             Targets="GenerateReactOSWidl"
             Properties="Configuration=$(Configuration);Platform=$(Platform);BuildProjectReferences=false"
             BuildInParallel="true" />
  </Target>
</Project>
