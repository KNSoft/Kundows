    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Win32ss\Libwin32k.vcxproj" />
    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Win32ss\Printing\Base\Winspool\Libwinspool.vcxproj" />
    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Sdk\Lib\Pathcch\Pathcch.vcxproj" />
    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Boot\Freeldr\Freeldr\Libfreeldr.vcxproj" />
    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Boot\Freeldr\Freeldr\Uefildr.vcxproj" />
    <NativeProject Include="$(MSBuildThisFileDirectory)..\..\Upstream\ReactOS\Projects\Dll\Directx\Wine\D3dx9_24\D3dx9_24.vcxproj" />
