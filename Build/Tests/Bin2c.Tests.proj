<Project DefaultTargets="GenerateReactOSBin2cProjectFiles" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <KundowsRoot>$(MSBuildThisFileDirectory)..\..\</KundowsRoot>
    <Platform>x64</Platform>
    <Configuration>Debug</Configuration>
    <Format Condition="'$(Format)' == ''">BINSTR</Format>
  </PropertyGroup>
  <Import Project="..\ReactOSBin2c.targets" />
  <ItemGroup>
    <ReactOSBin2c Include="$(FixtureRoot)\input.bin">
      <Arguments>"$(FixtureRoot)\input.bin" "$(FixtureRoot)\output.c" "$(FixtureRoot)\output.h" $(Format) FixtureData DATA_SEG(\"INITDATA\") attribute.h</Arguments>
      <Outputs>$(FixtureRoot)\output.c;$(FixtureRoot)\output.h</Outputs>
      <OutputDirectory>$(FixtureRoot)</OutputDirectory>
    </ReactOSBin2c>
  </ItemGroup>
  <Target Name="ResolveProjectReferences" />
</Project>
