<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSGenIncEnabled Condition="'$(ReactOSGenIncEnabled)' == ''">true</ReactOSGenIncEnabled>
    <ReactOSGenIncTool Condition="'$(ReactOSGenIncTool)' == '' and '$(Platform)' == 'ARM64' and '$(PROCESSOR_ARCHITECTURE)' == 'AMD64'">$(KundowsRoot)OutDir\HostTools\x64\$(Configuration)\geninc.exe</ReactOSGenIncTool>
    <ReactOSGenIncTool Condition="'$(ReactOSGenIncTool)' == ''">$(KundowsRoot)OutDir\HostTools\$(Platform)\$(Configuration)\geninc.exe</ReactOSGenIncTool>
    <ReactOSGenIncData Condition="'$(ReactOSGenIncData)' == ''">$(KundowsRoot)OutDir\Build\Generated\$(Platform)\$(Configuration)\GenIncData\genincdata.dll</ReactOSGenIncData>
    <ReactOSGenIncOutputDirectory Condition="'$(ReactOSGenIncOutputDirectory)' == ''">$(KundowsRoot)OutDir\Build\Generated\$(Platform)\$(Configuration)\sdk\include\asm</ReactOSGenIncOutputDirectory>
    <ReactOSGenIncOutputFile Condition="'$(ReactOSGenIncOutputFile)' == '' and '$(Platform)' == 'Win32'">$(ReactOSGenIncOutputDirectory)\ks386.inc</ReactOSGenIncOutputFile>
    <ReactOSGenIncOutputFile Condition="'$(ReactOSGenIncOutputFile)' == '' and '$(Platform)' == 'x64'">$(ReactOSGenIncOutputDirectory)\ksamd64.inc</ReactOSGenIncOutputFile>
    <ReactOSGenIncOutputFile Condition="'$(ReactOSGenIncOutputFile)' == '' and '$(Platform)' == 'ARM64'">$(ReactOSGenIncOutputDirectory)\ksarm64.h</ReactOSGenIncOutputFile>
  </PropertyGroup>
  <Target Name="GenerateReactOSGenInc"
          Condition="'$(ReactOSGenIncEnabled)' == 'true' and '$(ReactOSGenIncOutputFile)' != ''"
          BeforeTargets="PrepareForBuild"
          Inputs="$(ReactOSGenIncTool);$(ReactOSGenIncData);$(KundowsRoot)Upstream\ReactOS\Source\sdk\include\asm\ks386.template.h;$(KundowsRoot)Upstream\ReactOS\Source\sdk\include\asm\ksamd64.template.h;$(KundowsRoot)Upstream\ReactOS\Source\sdk\include\asm\ksarm64.template.h"
          Outputs="$(ReactOSGenIncOutputFile)">
    <Error Condition="!Exists('$(ReactOSGenIncTool)')" Text="HostTools.slnx must be built first for $(Platform)|$(Configuration): $(ReactOSGenIncTool)" />
    <Error Condition="!Exists('$(ReactOSGenIncData)')" Text="genincdata target artifact is missing for $(Platform)|$(Configuration): $(ReactOSGenIncData)" />
    <MakeDir Directories="$(ReactOSGenIncOutputDirectory)" />
    <Exec Command="&quot;$(ReactOSGenIncTool)&quot; &quot;$(ReactOSGenIncData)&quot; &quot;$(ReactOSGenIncOutputFile)&quot; -ms" />
  </Target>
</Project>
