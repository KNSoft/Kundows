<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSHostCommonIncludeDirectories Condition="'$(ReactOSHostMinimalIncludes)' != 'true'">
      $(ReactOSCommonIncludeDirectory);
      $(ReactOSCommonIncludeDirectory)psdk;
      $(KundowsRoot)Build\ReactOSHostIncludes;
      $(ReactOSSourceRoot)sdk\include\host;
      $(ReactOSSourceRoot)sdk\include;
      $(ReactOSSourceRoot)sdk\include\crt;
      $(ReactOSSourceRoot)sdk\include\ucrt;
      $(ReactOSSourceRoot)sdk\include\vcruntime;
      $(ReactOSSourceRoot)sdk\include\ddk;
      $(ReactOSSourceRoot)sdk\include\ndk;
      $(ReactOSSourceRoot)sdk\include\psdk;
      $(ReactOSSourceRoot)sdk\include\reactos;
      $(ReactOSSourceRoot)sdk\include\reactos\libs;
      $(ReactOSSourceRoot)sdk\include\winrt;
      $(ReactOSSourceRoot)sdk\lib\pseh\include;
      %(AdditionalIncludeDirectories)
    </ReactOSHostCommonIncludeDirectories>
    <ReactOSHostCommonIncludeDirectories Condition="'$(ReactOSHostMinimalIncludes)' == 'true'">
      $(ReactOSCommonIncludeDirectory);
      $(KundowsRoot)Build\ReactOSHostIncludes;
      $(ReactOSSourceRoot)sdk\include\host;
      %(AdditionalIncludeDirectories)
    </ReactOSHostCommonIncludeDirectories>
    <ReactOSHostDefines>__REACTOS__;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;HAVE_IO_H=1;WINVER=0x502;_WIN32_WINNT=0x502;PAGE_SIZE=0x1000</ReactOSHostDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'Win32'">
    <ReactOSHostDefines>$(ReactOSHostDefines);_M_IX86;_X86_;__i386__;i386;TARGET_i386</ReactOSHostDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <ReactOSHostDefines>$(ReactOSHostDefines);_M_AMD64;_M_X64;_AMD64_;__x86_64;__x86_64__;_WIN64;TARGET_amd64</ReactOSHostDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <ReactOSHostDefines>$(ReactOSHostDefines);_M_ARM64;_ARM64_;__arm64__;__aarch64__;_WIN64;TARGET_arm64;__arm64__</ReactOSHostDefines>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ReactOSHostCommonIncludeDirectories);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>$(ReactOSHostDefines)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <DisableSpecificWarnings>4018;4101;4113;4146;4244;4267;4311;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ObjectFileName>$(IntDir)%(Filename).obj</ObjectFileName>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>legacy_stdio_definitions.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Lib>
      <OutputFile>$(OutDir)$(TargetName).lib</OutputFile>
    </Lib>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
