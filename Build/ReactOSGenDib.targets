<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSGenDibHostPlatform>$(Platform)</ReactOSGenDibHostPlatform>
    <ReactOSGenDibHostPlatform Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">x64</ReactOSGenDibHostPlatform>
    <ReactOSGenDibTool>$(KundowsRoot)OutDir\HostTools\$(ReactOSGenDibHostPlatform)\$(Configuration)\gendib.exe</ReactOSGenDibTool>
  </PropertyGroup>
  <Target Name="GenerateReactOSGenDib"
          BeforeTargets="ClCompile;Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(ReactOSGenDib)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSGenDibTool)"
          Outputs="%(ReactOSGenDib.Outputs)">
    <MakeDir Directories="%(ReactOSGenDib.Identity)" />
    <Exec Command="&quot;$(ReactOSGenDibTool)&quot; &quot;%(ReactOSGenDib.Identity)&quot;" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSGenDib.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
