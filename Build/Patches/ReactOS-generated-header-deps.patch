Declare the SDK header producers for lwIP and the down-level PathCch
library. On a clean VS x64 Debug solution build at 4fbbefd614b, lwipallapps
and lwipmbedtls started before xdk supplied wdm.h; pathcch_static included
winscard.h before psdk supplied wtypes.h. The latter also prevented three
DLLs from linking. These are target dependencies, not compiler settings.

diff --git a/drivers/network/tcpip/CMakeLists.txt b/drivers/network/tcpip/CMakeLists.txt
--- a/drivers/network/tcpip/CMakeLists.txt
+++ b/drivers/network/tcpip/CMakeLists.txt
@@ -6,6 +6,8 @@ set(LWIP_INCLUDE_DIRS
 )
 include(${LWIP_DIR}/src/Filelists.cmake)
 add_dependencies(lwipcore xdk)
+add_dependencies(lwipallapps xdk)
+add_dependencies(lwipmbedtls xdk)
 add_subdirectory(ip)
 
 add_definitions(
diff --git a/sdk/lib/pathcch/CMakeLists.txt b/sdk/lib/pathcch/CMakeLists.txt
--- a/sdk/lib/pathcch/CMakeLists.txt
+++ b/sdk/lib/pathcch/CMakeLists.txt
@@ -4,7 +4,7 @@ include_directories(BEFORE ${REACTOS_SOURCE_DIR}/sdk/include/wine)
 # Down-level static PathCch library, to be used for
 # programs that need to run on Windows 7 and below.
 add_library(pathcch_static STATIC ${REACTOS_SOURCE_DIR}/dll/win32/kernelbase/wine/path.c StrRChrW.c)
-add_dependencies(pathcch_static xdk)
+add_dependencies(pathcch_static xdk psdk)
 target_compile_definitions(pathcch_static PRIVATE wcsnicmp=_wcsnicmp PATHCCH_NO_DEPRECATE WINSHLWAPI=)
 target_compile_definitions(pathcch_static PUBLIC STATIC_PATHCCH)
 
