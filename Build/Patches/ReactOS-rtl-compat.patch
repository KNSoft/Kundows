diff --git a/ntoskrnl/rtl/libsupp.c b/ntoskrnl/rtl/libsupp.c
index 462bea20fa0..876864909b2 100644
--- a/ntoskrnl/rtl/libsupp.c
+++ b/ntoskrnl/rtl/libsupp.c
@@ -147,6 +147,91 @@ LdrShutdownThread(VOID)
     return STATUS_SUCCESS;
 }
 
+/*
+ * The shared user-mode RTL contains activation-context code that is also
+ * linked into the kernel RTL library.  These loader entry points are
+ * user-mode services and have no kernel implementation; provide the kernel
+ * side stubs required when the shared object is selected by the linker.
+ */
+NTSTATUS
+NTAPI
+LdrLockLoaderLock(
+    _In_ ULONG Flags,
+    _Out_opt_ PULONG Disposition,
+    _Out_opt_ PULONG_PTR Cookie)
+{
+    UNREFERENCED_PARAMETER(Flags);
+    if (Disposition) *Disposition = 0;
+    if (Cookie) *Cookie = 0;
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+NTSTATUS
+NTAPI
+LdrUnlockLoaderLock(
+    _In_ ULONG Flags,
+    _In_opt_ ULONG_PTR Cookie)
+{
+    UNREFERENCED_PARAMETER(Flags);
+    UNREFERENCED_PARAMETER(Cookie);
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+NTSTATUS
+NTAPI
+LdrFindEntryForAddress(
+    _In_ PVOID Address,
+    _Out_ PLDR_DATA_TABLE_ENTRY *Module)
+{
+    UNREFERENCED_PARAMETER(Address);
+    if (Module) *Module = NULL;
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+VOID
+NTAPI
+LdrpInitializeProcessCompat(
+    _In_ PVOID ProcessActctx,
+    _Out_ PVOID *OldShimData)
+{
+    UNREFERENCED_PARAMETER(ProcessActctx);
+    if (OldShimData) *OldShimData = NULL;
+}
+
+ULONG
+NTAPI
+RtlGetTickCount(VOID)
+{
+    LARGE_INTEGER TickCount;
+    KeQueryTickCount(&TickCount);
+    return (ULONG)KiTickCountToMs(TickCount);
+}
+
+NTSTATUS
+NTAPI
+RtlDosApplyFileIsolationRedirection_Ustr(
+    _In_ ULONG Flags,
+    _In_ PUNICODE_STRING OriginalName,
+    _In_ PUNICODE_STRING Extension,
+    _Inout_ PUNICODE_STRING StaticString,
+    _Inout_ PUNICODE_STRING DynamicString,
+    _Inout_ PUNICODE_STRING *NewName,
+    _In_ PULONG NewFlags,
+    _In_ PSIZE_T FileNameSize,
+    _In_ PSIZE_T RequiredLength)
+{
+    UNREFERENCED_PARAMETER(Flags);
+    UNREFERENCED_PARAMETER(OriginalName);
+    UNREFERENCED_PARAMETER(Extension);
+    UNREFERENCED_PARAMETER(StaticString);
+    UNREFERENCED_PARAMETER(DynamicString);
+    UNREFERENCED_PARAMETER(NewName);
+    UNREFERENCED_PARAMETER(NewFlags);
+    UNREFERENCED_PARAMETER(FileNameSize);
+    UNREFERENCED_PARAMETER(RequiredLength);
+    return STATUS_NOT_IMPLEMENTED;
+}
+
 
 PPEB
 NTAPI
