Optional MM writeback fix (--image-fixes). Wait for a section page's
in-flight write before starting another or returning from its flush.
On 4fbbefd614b, seven controlled cases using the production MM functions
reported five failed checks before the change and none after it. They
reproduce stale writes and premature flush completion, but do not identify
the interleaving that damaged a particular installation disk.

diff --git a/ntoskrnl/mm/section.c b/ntoskrnl/mm/section.c
--- a/ntoskrnl/mm/section.c
+++ b/ntoskrnl/mm/section.c
@@ -5172,6 +5172,15 @@ MmFlushSegment(
     {
         ULONG_PTR Entry = MmGetPageEntrySectionSegment(Segment, &FlushStart);
 
+        /* A clean entry can still have an older write in flight. */
+        while (IS_WRITE_SSE(Entry))
+        {
+            MmUnlockSectionSegment(Segment);
+            KeDelayExecutionThread(KernelMode, FALSE, &TinyTime);
+            MmLockSectionSegment(Segment);
+            Entry = MmGetPageEntrySectionSegment(Segment, &FlushStart);
+        }
+
         if (IS_DIRTY_SSE(Entry))
         {
             MmCheckDirtySegment(Segment, &FlushStart, FALSE, FALSE);
@@ -5214,6 +5223,18 @@ MmCheckDirtySegment(
     DPRINT("Checking segment for file %wZ at offset 0x%I64X.\n", &Segment->FileObject->FileName, Offset->QuadPart);
 
     Entry = MmGetPageEntrySectionSegment(Segment, Offset);
+    while (IS_WRITE_SSE(Entry))
+    {
+        /*
+         * A previous write can still contain older data. Do not issue another
+         * write for this page until it completes, otherwise out-of-order I/O
+         * completion can overwrite a newer update and lose its dirty state.
+         */
+        MmUnlockSectionSegment(Segment);
+        KeDelayExecutionThread(KernelMode, FALSE, &TinyTime);
+        MmLockSectionSegment(Segment);
+        Entry = MmGetPageEntrySectionSegment(Segment, Offset);
+    }
     if (Entry == 0)
         return FALSE;
 
