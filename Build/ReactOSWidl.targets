<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ReactOSWidlHostPlatform>$(Platform)</ReactOSWidlHostPlatform>
    <ReactOSWidlHostPlatform Condition="'$(Platform)' == 'ARM64' and ('$(PROCESSOR_ARCHITECTURE)' == 'AMD64' or '$(PROCESSOR_ARCHITEW6432)' == 'AMD64')">x64</ReactOSWidlHostPlatform>
    <ReactOSWidlTool>$(KundowsRoot)OutDir\HostTools\$(ReactOSWidlHostPlatform)\$(Configuration)\widl.exe</ReactOSWidlTool>
    <ReactOSWidlSourceRoot>$([MSBuild]::NormalizePath('$(KundowsRoot)', 'Upstream', 'ReactOS', 'Source').Replace('\', '/'))</ReactOSWidlSourceRoot>
    <ReactOSWidlGeneratedRoot>$([MSBuild]::NormalizePath('$(KundowsRoot)', 'OutDir', 'Build', 'Generated', '$(Platform)', '$(Configuration)').Replace('\', '/'))</ReactOSWidlGeneratedRoot>
  </PropertyGroup>
  <Target Name="GenerateReactOSWidl"
          BeforeTargets="ClCompile;ResourceCompile;Lib;Link;Build"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'@(ReactOSWidl)' != ''"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildThisFileFullPath);$(ReactOSWidlTool);%(ReactOSWidl.Inputs)"
          Outputs="%(ReactOSWidl.Outputs)">
    <MakeDir Directories="%(ReactOSWidl.OutputDirectory)" />
    <Exec WorkingDirectory="%(ReactOSWidl.WorkingDirectory)" Command="&quot;$(ReactOSWidlTool)&quot; %(ReactOSWidl.Arguments)" />
    <Exec Condition="'%(ReactOSWidl.HeaderArguments)' != ''" WorkingDirectory="%(ReactOSWidl.WorkingDirectory)" Command="&quot;$(ReactOSWidlTool)&quot; %(ReactOSWidl.HeaderArguments)" />
    <ItemGroup>
      <FileWrites Include="%(ReactOSWidl.Outputs)" />
    </ItemGroup>
  </Target>
</Project>
