Historical incremental CC-only candidate, not a patch for the new queue.
Superseded by Runtime/ReactOS-cc-bcb-ownership.patch, which includes its base
BCB fixes too. Keep this file for the private-kernel evidence; do not stack it
on the reorganized runtime patch.
Base: ReactOS 4fbbefd614b plus existing cc-pinned-dirty, cc-duplicate-bcb
and mm-flush-status fixes. No FastFAT code or user-visible BCB layout change.
Retain dirty BCB ownership for pinned metadata streams, distinguish pinned
from mapped records, and retire only stable successful writeback epochs.
All BCB state uses BcbSpinLock; MM, resource waits and VACB release stay outside.
A per-VACB no-wait reservation prevents CC flushes overtaking one another.
Normal failed purge must not erase dirty records of a still-pinned view.
Only quiesced cache-map teardown may explicitly discard idle dirty records.
Evidence, intermediate counterexample, SMP assumptions and limitations are
recorded in CcOwnership.md and ../KernelTests. Not a general MM collision fix.

diff --git a/ntoskrnl/cc/pin.c b/ntoskrnl/cc/pin.c
--- a/ntoskrnl/cc/pin.c
+++ b/ntoskrnl/cc/pin.c
@@ -32,6 +32,134 @@
 ULONG CcPinMappedDataCount = 0;
 
 /* FUNCTIONS *****************************************************************/
+
+/* BCB list, references, pin counts and dirty epochs share BcbSpinLock.
+ * Never wait, call MM, or release a VACB while holding this spin lock. */
+static VOID
+CcpFreeBcb(PROS_SHARED_CACHE_MAP SharedCacheMap, PINTERNAL_BCB Bcb)
+{
+    ASSERT(Bcb->RefCount == 0);
+    ASSERT(Bcb->PinCount == 0);
+    ASSERT(Bcb->DirtyPublishers == 0);
+    CcRosReleaseVacb(SharedCacheMap, Bcb->Vacb, FALSE, FALSE);
+    ExDeleteResourceLite(&Bcb->Lock);
+    ExFreeToNPagedLookasideList(&iBcbLookasideList, Bcb);
+}
+
+static VOID
+CcpFreeBcbList(PROS_SHARED_CACHE_MAP SharedCacheMap, PLIST_ENTRY List)
+{
+    while (!IsListEmpty(List))
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(RemoveHeadList(List), INTERNAL_BCB, BcbEntry);
+        CcpFreeBcb(SharedCacheMap, Bcb);
+    }
+}
+
+BOOLEAN
+CcpBeginBcbFlush(PROS_VACB Vacb, PULONGLONG Generation)
+{
+    PROS_SHARED_CACHE_MAP Map = Vacb->SharedCacheMap;
+    KIRQL OldIrql;
+    *Generation = 0;
+    if (!Map->RetainDirtyBcbs)
+        return TRUE;
+
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    if (Vacb->BcbFlushActive)
+    {
+        KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+        return FALSE;
+    }
+    Vacb->BcbFlushActive = TRUE;
+    *Generation = Map->BcbDirtyGeneration;
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    return TRUE;
+}
+
+BOOLEAN
+CcpCompleteBcbFlush(PROS_VACB Vacb, ULONGLONG Generation, NTSTATUS Status)
+{
+    PROS_SHARED_CACHE_MAP Map = Vacb->SharedCacheMap;
+    LIST_ENTRY FreeList;
+    PLIST_ENTRY Entry, Next;
+    BOOLEAN Retry = FALSE;
+    KIRQL OldIrql;
+    if (!Map->RetainDirtyBcbs)
+        return FALSE;
+
+    InitializeListHead(&FreeList);
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    ASSERT(Vacb->BcbFlushActive);
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Next)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        Next = Entry->Flink;
+        if (Bcb->Vacb != Vacb)
+            continue;
+
+        /* A publisher can still be between its MM and dirty-list updates.
+         * Epoch arithmetic is modulo 2^64; an I/O cannot span 2^63 marks. */
+        if (NT_SUCCESS(Status) && Bcb->DirtyPublishers == 0 &&
+            (LONGLONG)(Generation - Bcb->DirtyGeneration) >= 0)
+        {
+            Bcb->DirtyPending = FALSE;
+            /* Dirty is the caller's premark intent, not a writeback receipt.
+             * An outstanding pin may modify the buffer after this flush. */
+            if (Bcb->PinCount == 0)
+                Bcb->Dirty = FALSE;
+        }
+        if (Bcb->RefCount == 0 && !Bcb->DirtyPending)
+        {
+            RemoveEntryList(Entry);
+            InsertTailList(&FreeList, Entry);
+        }
+        else if (Bcb->DirtyPending)
+        {
+            Retry = TRUE;
+        }
+    }
+    /* Keep the flush reservation until all unlocked retirement is finished.
+     * Another flush cannot overtake a delayed dirty-list re-publication. */
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    if (Retry)
+        CcRosMarkDirtyVacb(Vacb);
+    CcpFreeBcbList(Map, &FreeList);
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    Vacb->BcbFlushActive = FALSE;
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    return Retry;
+}
+
+VOID
+CcpDeleteBcbs(PROS_SHARED_CACHE_MAP Map)
+{
+    LIST_ENTRY FreeList;
+    PLIST_ENTRY Entry, Next;
+    KIRQL OldIrql;
+    if (!Map->RetainDirtyBcbs)
+        return;
+
+    InitializeListHead(&FreeList);
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Next)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        PROS_VACB Vacb = Bcb->Vacb;
+        Next = Entry->Flink;
+        /* Only the quiesced cache-map teardown calls this discard path.
+         * A normal purge can still fail because another page is pinned; it
+         * must not first erase the dirty BCBs of that unpurged view. */
+        if (Bcb->RefCount == 0 && !Vacb->BcbFlushActive)
+        {
+            RemoveEntryList(Entry);
+            InsertTailList(&FreeList, Entry);
+        }
+    }
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    CcpFreeBcbList(Map, &FreeList);
+}
+
 
