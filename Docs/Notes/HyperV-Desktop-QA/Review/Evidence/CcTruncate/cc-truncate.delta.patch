+BOOLEAN
+NTAPI
+CcPurgeCacheSection (
+    IN PSECTION_OBJECT_POINTERS SectionObjectPointer,
+    IN PLARGE_INTEGER FileOffset OPTIONAL,
+    IN ULONG Length,
+    IN BOOLEAN UninitializeCacheMaps)
+{
+    return CcpPurgeCacheSection(SectionObjectPointer, FileOffset, Length, UninitializeCacheMaps, FALSE);
+}
+
+/* Called under CacheMapLock. File sizes are supplied by the file system;
+ * the lowest suffix still to purge is separate from those sizes. */
+static VOID
+CcpNoteTruncate(PROS_SHARED_CACHE_MAP Map, LARGE_INTEGER Offset)
+{
+    if (!Map->TruncatePending || Offset.QuadPart < Map->TruncateOffset.QuadPart)
+        Map->TruncateOffset = Offset;
+    Map->TruncatePending = TRUE;
+}
+
+static BOOLEAN
+CcpFinishTruncate(PFILE_OBJECT FileObject, PROS_SHARED_CACHE_MAP Map,
+                  LARGE_INTEGER Offset)
+{
+    KIRQL OldIrql;
+    BOOLEAN Done;
+
+    if (!CcpPurgeCacheSection(FileObject->SectionObjectPointer, &Offset, 0, FALSE, TRUE))
+        return FALSE;
+
+    KeAcquireSpinLock(&Map->CacheMapLock, &OldIrql);
+    if (Map->TruncateOffset.QuadPart == Offset.QuadPart)
+        Map->TruncatePending = FALSE;
+    Done = !Map->TruncatePending;
+    KeReleaseSpinLock(&Map->CacheMapLock, OldIrql);
+    return Done;
+}
 
