+      length = strlen(line);
+      pattern_length = strlen(pattern);
+      return length >= pattern_length &&
+             memcmp(line + (length - pattern_length), pattern, pattern_length) == 0;
+    }
+  return strstr(line, pattern) != NULL;
+}
 
