 /* Symbol definition */
 #define MAX_STR 1024
 
+static int
+matches_line(const char *line, const char *pattern, int at_start, int at_end)
+{
+  size_t length, pattern_length;
+
+  if (at_start && at_end)
+    return strcmp(line, pattern) == 0;
+  if (at_start)
+    return strncmp(line, pattern, strlen(pattern)) == 0;
+  if (at_end)
