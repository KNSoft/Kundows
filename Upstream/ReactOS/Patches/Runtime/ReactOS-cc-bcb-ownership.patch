+    KIRQL OldIrql;
+    BOOLEAN CacheBusy;
+
+    if (!CcpPurgeCacheSection(FileObject->SectionObjectPointer, &Offset, 0, FALSE, TRUE, &CacheBusy))
+        return CacheBusy ? STATUS_SUCCESS : STATUS_PURGE_FAILED;
+
+    KeAcquireSpinLock(&Map->CacheMapLock, &OldIrql);
+    if (Map->TruncateOffset.QuadPart == Offset.QuadPart)
+        Map->TruncatePending = FALSE;
+    KeReleaseSpinLock(&Map->CacheMapLock, OldIrql);
+    return STATUS_SUCCESS;
+}
 
