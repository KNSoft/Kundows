+/* BCB list, references, pin counts and pending pages share BcbSpinLock.
+ * Never wait, call MM, or release a VACB while holding this spin lock. */
+static VOID
+CcpFreeBcb(PINTERNAL_BCB Bcb)
+{
+    ASSERT(Bcb->RefCount == 0);
+    ASSERT(Bcb->PinCount == 0);
+    ASSERT(!Bcb->PendingPages);
+    ASSERT(Bcb->Vacb == NULL);
+    ExDeleteResourceLite(&Bcb->Lock);
+    ExFreeToNPagedLookasideList(&iBcbLookasideList, Bcb);
+}
+
+VOID
+CcpFreeBcbList(PLIST_ENTRY List)
+{
+    while (!IsListEmpty(List))
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(RemoveHeadList(List), INTERNAL_BCB, BcbEntry);
+        CcpFreeBcb(Bcb);
+    }
+}
+
+NTSTATUS
+CcpDeleteBcbs(PROS_SHARED_CACHE_MAP Map)
+{
+    LIST_ENTRY FreeList;
+    PLIST_ENTRY Entry, Next;
+    KIRQL OldIrql;
+    NTSTATUS FirstError = STATUS_SUCCESS;
+    if (!Map->RetainDirtyBcbs)
+        return STATUS_SUCCESS;
+
+    InitializeListHead(&FreeList);
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Next)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        Next = Entry->Flink;
+        /* Only the quiesced cache-map teardown calls this discard path.
+         * A normal purge can still fail because another page is pinned; it
+         * must not first erase the dirty BCBs of that unpurged view. */
+        if (Bcb->RefCount == 0 && Map->ActiveBcbFlushes == 0)
+        {
+            RemoveEntryList(Entry);
+            InsertTailList(&FreeList, Entry);
+        }
+    }
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    /* Quiesced, with all system views still mapped on the private VACB list.
+     * System PTE dirty bits are not harvested when ROS unmaps these views. */
+    for (Entry = FreeList.Flink; Entry != &FreeList; Entry = Entry->Flink)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        LONGLONG Base = ROUND_DOWN(Bcb->PFCB.MappedFileOffset.QuadPart, VACB_MAPPING_GRANULARITY);
+        ULONG Page;
+        if (Map->PurgeOnClose)
+            Bcb->PendingPages = 0;
+        for (Page = 0; Bcb->PendingPages; ++Page, Bcb->PendingPages >>= 1)
+            if (Bcb->PendingPages & 1)
+            {
+                NTSTATUS Status = MmMakeSegmentDirty(Map->FileObject->SectionObjectPointer,
+                                                     Base + Page * PAGE_SIZE, PAGE_SIZE);
+                if (NT_SUCCESS(FirstError) && !NT_SUCCESS(Status))
+                    FirstError = Status;
+            }
+    }
+    CcpFreeBcbList(&FreeList);
+    return FirstError;
+}
+
+BOOLEAN
+CcpCanPurgeBcbRange(PROS_SHARED_CACHE_MAP Map, LONGLONG Start, LONGLONG End)
+{
+    KIRQL OldIrql;
+    PLIST_ENTRY Entry;
+    BOOLEAN CanPurge = TRUE;
+    if (!Map->RetainDirtyBcbs)
+        return TRUE;
+
+    KeAcquireSpinLock(&Map->BcbSpinLock, &OldIrql);
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Entry->Flink)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        /* An ordinary purge is allowed to fail. Do not discard ownership. */
+        LONGLONG View = ROUND_DOWN(Bcb->PFCB.MappedFileOffset.QuadPart, VACB_MAPPING_GRANULARITY);
+        if (Bcb->DirtyPending && View < End && Start - View < VACB_MAPPING_GRANULARITY)
+        {
+            CanPurge = FALSE;
+            break;
+        }
+    }
+    KeReleaseSpinLock(&Map->BcbSpinLock, OldIrql);
+    return CanPurge;
+}
+
+/* The FSD has already truncated the stream. Master and CacheMapLock exclude
+ * new view lookups; the caller checked the affected views for external refs.
+ * Validate the entire BCB pass before discarding any now-invalid suffix. */
+BOOLEAN
+CcpTruncateBcbs(PROS_SHARED_CACHE_MAP Map, LONGLONG Tail, PLIST_ENTRY Retired)
+{
+    PLIST_ENTRY Entry, Next;
+
+    if (!Map->RetainDirtyBcbs)
+        return TRUE;
+    KeAcquireSpinLockAtDpcLevel(&Map->BcbSpinLock);
+    if (Map->ActiveBcbFlushes)
+        goto busy;
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Entry->Flink)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        LONGLONG Start = Bcb->PFCB.MappedFileOffset.QuadPart;
+        if ((Start >= Tail || Tail - Start < Bcb->PFCB.MappedLength) &&
+            (Bcb->RefCount || Bcb->PinCount || Bcb->Vacb))
+            goto busy;
+    }
+    for (Entry = Map->BcbList.Flink; Entry != &Map->BcbList; Entry = Next)
+    {
+        PINTERNAL_BCB Bcb = CONTAINING_RECORD(Entry, INTERNAL_BCB, BcbEntry);
+        LONGLONG Start = Bcb->PFCB.MappedFileOffset.QuadPart;
+        Next = Entry->Flink;
+        if (Start < Tail)
+        {
+            ULONG LastPage;
+            if (Tail - Start >= Bcb->PFCB.MappedLength)
+                continue;
+            /* A BCB fits within one VACB. Include the last partial page;
+             * never republish or match bytes beyond the new record end. */
+            LastPage = (ULONG)((Tail - 1) % VACB_MAPPING_GRANULARITY) / PAGE_SIZE;
+            Bcb->PFCB.MappedLength = (ULONG)(Tail - Start);
+            C_ASSERT(VACB_MAPPING_GRANULARITY / PAGE_SIZE <= 64);
+            Bcb->PendingPages &= ~0ULL >> (63 - LastPage);
+        }
+        else
+        {
+            Bcb->PendingPages = 0;
+        }
+        Bcb->DirtyPending = Bcb->PendingPages != 0;
+        if (!Bcb->DirtyPending)
+        {
+            RemoveEntryList(Entry);
+            InsertTailList(Retired, Entry);
+        }
+    }
+    KeReleaseSpinLockFromDpcLevel(&Map->BcbSpinLock);
+    return TRUE;
+
+busy:
+    KeReleaseSpinLockFromDpcLevel(&Map->BcbSpinLock);
+    return FALSE;
+}
