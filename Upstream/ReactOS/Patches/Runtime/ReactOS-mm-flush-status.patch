Report the first failed section-page write and stop counting at that page.
Preserve the page-out release boolean, the failed dirty page and retry.
After the first failed VACB, bound the remaining attempts in the global CC
pass by the current number of dirty views. This lets other views write and
prevents an immediately requeued permanent error from spinning at shutdown.
On 4fbbefd614b, 8/21 -> 21/21 controlled MM/CC checks passed, including a
partial range, a healthy peer, explicit and background retries. Information
keeps the existing page-based units. This is not evidence of which I/O, if
any, failed on an installation disk. Serialization is a separate patch.

diff --git a/ntoskrnl/cc/view.c b/ntoskrnl/cc/view.c
index 9683c31d8af..6b14528399b 100644
--- a/ntoskrnl/cc/view.c
+++ b/ntoskrnl/cc/view.c
@@ -353,4 +353,6 @@ CcRosFlushDirtyPages (
     PLIST_ENTRY current_entry;
     NTSTATUS Status;
+    NTSTATUS FirstError = STATUS_SUCCESS;
+    ULONG AttemptsLeft = 0;
     KIRQL OldIrql;
     BOOLEAN FlushAll = (Target == MAXULONG);
@@ -375,8 +377,11 @@ CcRosFlushDirtyPages (
         BOOLEAN Locked;
 
+        if (!NT_SUCCESS(FirstError) && AttemptsLeft == 0)
+            break;
+
         if (current_entry == &DirtyVacbListHead)
         {
             ASSERT(FlushAll);
-            if (IsListEmpty(&DirtyVacbListHead))
+            if (!NT_SUCCESS(FirstError) || IsListEmpty(&DirtyVacbListHead))
                 break;
             current_entry = DirtyVacbListHead.Flink;
@@ -454,8 +459,18 @@ CcRosFlushDirtyPages (
             CcRosDeleteFileCache(SharedCacheMap->FileObject, SharedCacheMap, &OldIrql);
 
-        if (!NT_SUCCESS(Status) && (Status != STATUS_END_OF_FILE) &&
-            (Status != STATUS_MEDIA_WRITE_PROTECTED))
+        if (!NT_SUCCESS(FirstError))
+            --AttemptsLeft;
+
+        if (!NT_SUCCESS(Status))
         {
-            DPRINT1("CC: Failed to flush VACB.\n");
+            if (NT_SUCCESS(FirstError))
+            {
+                FirstError = Status;
+                /* A failed VACB is requeued at the tail. Give the other
+                 * dirty views a turn without retrying a bad disk forever. */
+                AttemptsLeft = CcTotalDirtyPages / (VACB_MAPPING_GRANULARITY / PAGE_SIZE);
+            }
+            if (Status != STATUS_END_OF_FILE && Status != STATUS_MEDIA_WRITE_PROTECTED)
+                DPRINT1("CC: Failed to flush VACB. Status: 0x%08lx\n", Status);
         }
         else
@@ -489,5 +504,5 @@ CcRosFlushDirtyPages (
 
     DPRINT("CcRosFlushDirtyPages() finished\n");
-    return STATUS_SUCCESS;
+    return FirstError;
 }
 
