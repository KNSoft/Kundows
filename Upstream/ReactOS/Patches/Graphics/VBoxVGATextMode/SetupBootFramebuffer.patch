+
+/* Present the Setup text grid through the active boot video driver. */
+#include "blue.h"
+#include "setupfb.h"
+#include <arc/arc.h>
+#include <ndk/kefuncs.h>
+#include <drivers/bootvid/bootvid.h>
+#include <drivers/bootvid/framebuf.h>
+
+extern UCHAR BlueFont437[256 * 8];
+
+/* Called once by DriverEntry. Never keep a pointer into the loader block. */
+BOOLEAN
+ScrUsesBootFramebuffer(VOID)
+{
+    PCONFIGURATION_COMPONENT_DATA Entry = NULL;
+    if (!KeLoaderBlock || !KeLoaderBlock->SetupLdrBlock)
+        return FALSE;
+
+    while ((Entry = KeFindConfigurationNextEntry(KeLoaderBlock->ConfigurationRoot,
+                    ControllerClass, DisplayController, NULL, &Entry)) != NULL)
+    {
+        PCM_PARTIAL_RESOURCE_LIST List = Entry->ConfigurationData;
+        ULONG Length = Entry->ComponentEntry.ConfigurationDataLength;
+        ULONG Header = FIELD_OFFSET(CM_PARTIAL_RESOURCE_LIST, PartialDescriptors);
+        PCM_PARTIAL_RESOURCE_DESCRIPTOR Last;
+        if (!(Entry->ComponentEntry.Flags & ConsoleOut) || !List || Length < Header ||
+            List->Version < 1 || (List->Version == 1 && List->Revision < 2) ||
+            !List->Count || List->Count > (Length - Header) / sizeof(*Last))
+            continue;
+
+        /* Same boot display resource that selects lfbbvid in FreeLdr. */
+        Last = &List->PartialDescriptors[List->Count - 1];
+        if (Last->Type == CmResourceTypeDeviceSpecific &&
+            Last->u.DeviceSpecificData.DataSize >= sizeof(CM_FRAMEBUF_DEVICE_DATA) &&
+            Last->u.DeviceSpecificData.DataSize <= Length - Header - List->Count * sizeof(*Last))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+VOID
+ScrFbDefaultFont(PSETUP_FB Fb)
+{
+    RtlCopyMemory(Fb->Font, BlueFont437, sizeof(Fb->Font));
+}
+
+/* BOOTVID's palette numbers are different from VGA character attributes. */
+static const UCHAR TextColor[16] =
+{
+    BV_COLOR_BLACK, BV_COLOR_BLUE, BV_COLOR_GREEN, BV_COLOR_CYAN,
+    BV_COLOR_RED, BV_COLOR_MAGENTA, BV_COLOR_BROWN, BV_COLOR_LIGHT_GRAY,
+    BV_COLOR_DARK_GRAY, BV_COLOR_LIGHT_BLUE, BV_COLOR_LIGHT_GREEN, BV_COLOR_LIGHT_CYAN,
+    BV_COLOR_LIGHT_RED, BV_COLOR_LIGHT_MAGENTA, BV_COLOR_YELLOW, BV_COLOR_WHITE
+};
+
+VOID
+ScrFbPresent(PSETUP_FB Fb, volatile BOOLEAN *Enabled, ULONG Cursor,
+             ULONG CursorLines, BOOLEAN Repaint)
+{
+    ULONG i, x, y;
+    UCHAR Pixels[8][4]; /* A top-down, packed 4bpp glyph for VidBufferToScreenBlt */
+
+    for (i = 0; i < SETUP_CELLS && *Enabled; ++i)
+    {
+        USHORT Cell = Fb->Cells[i];
+        ULONG Lines = (i == Cursor) ? CursorLines : 0;
+        ULONG Key = Cell | (Lines << 16);
+        UCHAR Fg, Bg;
+        if (!Repaint && Fb->Presented[i] == Key)
+            continue;
+        Fg = TextColor[(Cell >> 8) & 15];
+        Bg = TextColor[Cell >> 12];
+        for (y = 0; y < 8; ++y)
+        {
+            UCHAR Glyph = (y >= 8 - Lines) ? 0xff : Fb->Font[(Cell & 255) * 8 + y];
+            for (x = 0; x < 4; ++x, Glyph <<= 2)
+                Pixels[y][x] = ((Glyph & 0x80 ? Fg : Bg) << 4) | (Glyph & 0x40 ? Fg : Bg);
+        }
+        if (!*Enabled) break;
+        VidBufferToScreenBlt(&Pixels[0][0], (i % SETUP_COLUMNS) * 8,
+                             (SCREEN_HEIGHT - SETUP_ROWS * 8) / 2 + (i / SETUP_COLUMNS) * 8,
+                             8, 8, sizeof(Pixels[0]));
+        Fb->Presented[i] = Key;
+    }
+}
