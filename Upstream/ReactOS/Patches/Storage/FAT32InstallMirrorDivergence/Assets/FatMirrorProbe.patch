+
+/* Disposable x64 Debug installation probe. No control device or file I/O. */
+#if !DBG || !defined(_M_AMD64)
+#error This probe is only for the x64 Debug Hyper-V fixture
+#endif
+#define KW_SLOTS 32768
+#define KW_SAMPLES 256
+typedef struct _KW_MIRROR_WRITE {
+    ULONG Group, Mirror, Submit, Complete, Vbo, Lbo, Length, Sample;
+    NTSTATUS Status;
+    ULONG Reserved;
+    ULONGLONG Transferred;
+} KW_MIRROR_WRITE;
+C_ASSERT(sizeof(KW_MIRROR_WRITE) == 48);
+static KW_MIRROR_WRITE KwWrites[KW_SLOTS];
+static UCHAR KwPayloads[KW_SAMPLES][512];
+static struct {
+    UCHAR Magic[16];
+    volatile LONG Groups, Count, Sequence, Samples, Closed;
+    ULONG Reserved;
+    PVOID Self, Writes, Payloads;
+} KwLog = { "KW-FAT-TRACE-V1", 0, 0, 0, 0, 0, 0, &KwLog, KwWrites, KwPayloads };
+C_ASSERT(sizeof(KwLog) == 64);
+
+static ULONG
+KwSubmit(ULONG Group, ULONG Mirror, PIO_RUN Run, PIRP Master, ULONG WatchedVbo)
+{
+    LONG Slot = InterlockedIncrement(&KwLog.Count);
+    KW_MIRROR_WRITE *R;
+    if ((ULONG)Slot > KW_SLOTS) return 0;
+    R = &KwWrites[Slot - 1];
+    R->Group = Group;
+    R->Mirror = Mirror;
+    R->Vbo = Run->Vbo;
+    R->Lbo = Run->Lbo;
+    R->Length = Run->ByteCount;
+    if (WatchedVbo >= R->Vbo &&
+        (ULONGLONG)WatchedVbo + 512 <= (ULONGLONG)R->Vbo + R->Length)
+    {
+        ULONG Offset = Run->Offset + (WatchedVbo - R->Vbo);
+        LONG N = InterlockedIncrement(&KwLog.Samples);
+        if ((ULONG)N <= KW_SAMPLES && Master->MdlAddress &&
+            (ULONGLONG)Offset + 512 <= MmGetMdlByteCount(Master->MdlAddress))
+        {
+            PUCHAR Buf = MmGetSystemAddressForMdlSafe(Master->MdlAddress, NormalPagePriority);
+            if (Buf)
+            {
+                RtlCopyMemory(KwPayloads[N - 1], Buf + Offset, 512);
+                R->Sample = N;
+            }
+        }
+    }
+    R->Submit = InterlockedIncrement(&KwLog.Sequence);
+    return Slot;
+}
+
+static VOID
+KwComplete(PIRP Irp)
+{
+    ULONG Key = IoGetCurrentIrpStackLocation(Irp)->Parameters.Write.Key;
+    if (Key && Key <= KW_SLOTS)
+    {
+        KW_MIRROR_WRITE *R = &KwWrites[Key - 1];
+        R->Status = Irp->IoStatus.Status;
+        R->Transferred = Irp->IoStatus.Information;
+        R->Complete = InterlockedIncrement(&KwLog.Sequence);
+    }
+}
+
+VOID KwEndCapture(VOID)
+{
+    /* Host saves RAM during this bounded window, after the volume loop
+     * and after releasing the global resource. No delay during writes. */
+    if (KwLog.Count && !InterlockedCompareExchange(&KwLog.Closed, 1, 0))
+    {
+        LARGE_INTEGER Interval;
+        Interval.QuadPart = -90LL * 1000 * 1000 * 10;
+        KeDelayExecutionThread(KernelMode, FALSE, &Interval);
+    }
+}
