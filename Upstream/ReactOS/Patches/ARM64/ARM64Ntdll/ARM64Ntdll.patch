+
+/* ARM64 128-bit interlocked operation. */
+#include <kxarm64.h>
+
+    TEXTAREA
+
+/*
+ * BOOLEAN
+ * NTAPI
+ * RtlpInterlockedCompareExchange128(
+ *     _Inout_ volatile LONG64 *Destination,
+ *     _In_ LONG64 ExchangeHigh,
+ *     _In_ LONG64 ExchangeLow,
+ *     _Inout_ PLONG64 ComparandResult);
+ *
+ * The ARM64 MSVC intrinsic is supplied by the CRT, which is not linked into
+ * ReactOS system libraries.  Keep the operation local and use the baseline
+ * ARMv8 load-linked/store-conditional pair instead.
+ */
+    LEAF_ENTRY RtlpInterlockedCompareExchange128
+    ldr x6, [x3]
+    ldr x7, [x3, #8]
+
+LABEL(RtlpInterlockedCompareExchange128Retry)
+    ldaxp x4, x5, [x0]
+    cmp x4, x6
+    ccmp x5, x7, #0, eq
+    b.ne RtlpInterlockedCompareExchange128Fail
+    stlxp w8, x2, x1, [x0]
+    cbnz w8, RtlpInterlockedCompareExchange128Retry
+    dmb ish
+    mov w0, #1
+    ret
+
+LABEL(RtlpInterlockedCompareExchange128Fail)
+    clrex
+    str x4, [x3]
+    str x5, [x3, #8]
+    dmb ish
+    mov w0, #0
+    ret
+    LEAF_END RtlpInterlockedCompareExchange128
+
+    END
diff --git a/sdk/lib/rtl/slist.c b/sdk/lib/rtl/slist.c
index a9541c2d37f..6519746a97f 100644
--- a/sdk/lib/rtl/slist.c
+++ b/sdk/lib/rtl/slist.c
@@ -18,6 +18,111 @@
 BOOLEAN RtlpUse16ByteSLists = -1;
 #endif
 
+#if defined(_M_ARM64) || defined(_ARM64_) || defined(__arm64__) || defined(__aarch64__)
+BOOLEAN
+NTAPI
+RtlpInterlockedCompareExchange128(
+    _Inout_ volatile LONG64 *Destination,
+    _In_ LONG64 ExchangeHigh,
+    _In_ LONG64 ExchangeLow,
+    _Inout_ PLONG64 ComparandResult);
+#define ROS_INTERLOCKED_COMPARE_EXCHANGE128 RtlpInterlockedCompareExchange128
+#else
+#define ROS_INTERLOCKED_COMPARE_EXCHANGE128 _InterlockedCompareExchange128
+#endif
+
+#if defined(_M_ARM64) || defined(_ARM64_) || defined(__arm64__) || defined(__aarch64__)
+
+/*
+ * ARM64 uses the 16-byte SList header.  Keep these operations in C so the
+ * compiler can select the native 128-bit compare/exchange primitive.
+ */
+PSLIST_ENTRY
+NTAPI
+RtlInterlockedPushEntrySList(
+    _Inout_ PSLIST_HEADER SListHead,
+    _Inout_ __drv_aliasesMem PSLIST_ENTRY SListEntry)
+{
+    SLIST_HEADER OldSListHead, NewSListHead;
+
+    do
+    {
+        OldSListHead = *SListHead;
+        SListEntry->Next = (PSLIST_ENTRY)(OldSListHead.Region & ~0xFULL);
+
+        NewSListHead = OldSListHead;
+        NewSListHead.Header16.Depth++;
+        NewSListHead.Header16.Sequence++;
+        NewSListHead.Region = (ULONG64)SListEntry;
+        NewSListHead.Header16.HeaderType = 1;
+        NewSListHead.Header16.Init = 1;
+    }
+    while (!ROS_INTERLOCKED_COMPARE_EXCHANGE128(
+        (volatile LONG64 *)SListHead,
+        (LONG64)NewSListHead.Region,
+        (LONG64)NewSListHead.Alignment,
+        (LONG64 *)&OldSListHead));
+
+    return (PSLIST_ENTRY)(OldSListHead.Region & ~0xFULL);
+}
+
+PSLIST_ENTRY
+NTAPI
+RtlInterlockedPopEntrySList(
+    _Inout_ PSLIST_HEADER SListHead)
+{
+    SLIST_HEADER OldSListHead, NewSListHead;
+    PSLIST_ENTRY Entry;
+
+    do
+    {
+        OldSListHead = *SListHead;
+        Entry = (PSLIST_ENTRY)(OldSListHead.Region & ~0xFULL);
+        if (!Entry)
+            return NULL;
+
+        NewSListHead = OldSListHead;
+        NewSListHead.Region = (ULONG64)Entry->Next;
+        NewSListHead.Header16.Depth--;
+        NewSListHead.Header16.HeaderType = 1;
+        NewSListHead.Header16.Init = 1;
+    }
+    while (!ROS_INTERLOCKED_COMPARE_EXCHANGE128(
+        (volatile LONG64 *)SListHead,
+        (LONG64)NewSListHead.Region,
+        (LONG64)NewSListHead.Alignment,
+        (LONG64 *)&OldSListHead));
+
+    return Entry;
+}
+
+PSLIST_ENTRY
+NTAPI
+RtlInterlockedFlushSList(
+    _Inout_ PSLIST_HEADER SListHead)
+{
+    SLIST_HEADER OldSListHead, NewSListHead;
+
+    do
+    {
+        OldSListHead = *SListHead;
+        NewSListHead = OldSListHead;
+        NewSListHead.Region = 0;
+        NewSListHead.Header16.Depth = 0;
+        NewSListHead.Header16.HeaderType = 1;
+        NewSListHead.Header16.Init = 1;
+    }
+    while (!ROS_INTERLOCKED_COMPARE_EXCHANGE128(
+        (volatile LONG64 *)SListHead,
+        (LONG64)NewSListHead.Region,
+        (LONG64)NewSListHead.Alignment,
+        (LONG64 *)&OldSListHead));
+
+    return (PSLIST_ENTRY)(OldSListHead.Region & ~0xFULL);
+}
+
+#endif
+
 /* FUNCTIONS ***************************************************************/
 
 VOID
@@ -132,7 +237,7 @@ RtlInterlockedPushListSList(
             NewSListHead.Header16.Init = 1;
 
             /* Atomically exchange the SlistHead with the new one */
-            exchanged = _InterlockedCompareExchange128((PLONG64)SListHead,
+            exchanged = ROS_INTERLOCKED_COMPARE_EXCHANGE128((PLONG64)SListHead,
                                                        NewSListHead.Region,
                                                        NewSListHead.Alignment,
                                                        (PLONG64)&OldSListHead);
@@ -221,7 +326,7 @@ RtlInterlockedPushListSListEx(
 }
 #endif
 
-#if !defined(_M_IX86) && !defined(_M_AMD64)
+#if !defined(_M_IX86) && !defined(_M_AMD64) && !defined(_M_ARM64) && !defined(_ARM64_) && !defined(__arm64__) && !defined(__aarch64__)
 
 _WARN("C based S-List functions can bugcheck, if not handled properly in kernel")
 
