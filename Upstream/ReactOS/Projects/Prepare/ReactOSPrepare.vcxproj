      <MessageResource>$(ReactOSMessageOutputDirectory)\netmsgmsg.rc</MessageResource>
    </ReactOSMessageSource>
    <ReactOSMessageSource Include="$(ReactOSSourceRoot)sdk\include\reactos\mc\ntiologc.mc">
