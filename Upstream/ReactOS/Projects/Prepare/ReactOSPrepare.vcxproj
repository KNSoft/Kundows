      <MessageHeader>$(ReactOSMessageOutputDirectory)\ntstatus.h</MessageHeader>
      <MessageResource>$(ReactOSMessageOutputDirectory)\ntstatus.rc</MessageResource>
    </ReactOSMessageSource>
    <ReactOSMessageSource Include="$(ReactOSSourceRoot)sdk\include\reactos\mc\pciclass.mc">
      <MessageMode>UNICODE</MessageMode>
      <MessageHeader>$(ReactOSMessageOutputDirectory)\pciclass.h</MessageHeader>
      <MessageResource>$(ReactOSMessageOutputDirectory)\pciclass.rc</MessageResource>
